import java.util.*;

public class ExercicioComplementar {

    public static void main(String[] args) {

        // =====================================================
        // 1. sortedset - consultas por faixa de preço
        // =====================================================

        SortedSet<Double> precos = new TreeSet<>();

        precos.add(50.0);
        precos.add(100.0);
        precos.add(150.0);
        precos.add(200.0);
        precos.add(250.0);
        precos.add(300.0);
        precos.add(400.0);

        System.out.println("===== PREÇOS =====");
        System.out.println(precos);

        // Preços entre 100 e 300
        System.out.println("\nPreços entre 100 e 300:");
        System.out.println(precos.subSet(100.0, 300.0));

        // Preços abaixo de 250
        System.out.println("\nPreços abaixo de 250:");
        System.out.println(precos.headSet(250.0));

        // Preços a partir de 250
        System.out.println("\nPreços a partir de 250:");
        System.out.println(precos.tailSet(250.0));


        // =====================================================
        // 2. queue - fila de pedidos
        // =====================================================

        Queue<String> fila = new LinkedList<>();

        fila.offer("Pedido 001");
        fila.offer("Pedido 002");
        fila.offer("Pedido 003");
        fila.offer("Pedido 004");

        System.out.println("\n===== FILA DE PEDIDOS =====");

        // Mostra o primeiro pedido sem removê-lo
        System.out.println("Próximo pedido: " + fila.peek());

        // Processa os pedidos
        while (fila.peek() != null) {
            System.out.println("Processando: " + fila.poll());
        }


        // =====================================================
        // 3. collections
        // =====================================================

        List<String> produtos = new ArrayList<>();

        produtos.add("Notebook");
        produtos.add("Mouse");
        produtos.add("Teclado");
        produtos.add("Monitor");
        produtos.add("Headset");

        System.out.println("\n===== COLLECTIONS =====");

        System.out.println("Lista original:");
        System.out.println(produtos);

        // Embaralha a lista
        Collections.shuffle(produtos);

        System.out.println("\nApós shuffle():");
        System.out.println(produtos);

        // Inverte a lista
        Collections.reverse(produtos);

        System.out.println("\nApós reverse():");
        System.out.println(produtos);

        // Encontra o menor elemento
        System.out.println("\nMenor elemento: "
                + Collections.min(produtos));

        // Encontra o maior elemento
        System.out.println("Maior elemento: "
                + Collections.max(produtos));


        // =====================================================
        // 4. synchronizedlist 
        // =====================================================

        List<String> listaSincronizada =
                Collections.synchronizedList(new ArrayList<>());

        listaSincronizada.add("Produto A");
        listaSincronizada.add("Produto B");
        listaSincronizada.add("Produto C");

        System.out.println("\n===== LISTA SINCRONIZADA =====");
        System.out.println(listaSincronizada);


        // =====================================================
        // 5. hashtable + enumeration
        // =====================================================

        Hashtable<String, String> sessoes = new Hashtable<>();

        sessoes.put("Usuario1", "Ativo");
        sessoes.put("Usuario2", "Ativo");
        sessoes.put("Usuario3", "Inativo");
        sessoes.put("Usuario4", "Ativo");

        System.out.println("\n===== SESSÕES =====");

        Enumeration<String> elementos = sessoes.elements();

        while (elementos.hasMoreElements()) {
            System.out.println("Status: " + elementos.nextElement());
        }
    }
}
